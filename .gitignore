__pycache__/
*.pyc
.venv/
venv/
.env
trail/*.jsonl
trail/*.head
# A chain closed because the record shape changed. Kept locally so the roll forward is
# auditable on the machine it happened on, never committed: it is a record, not source.
trail/*.closed-*
.DS_Store
golden_path/agents/

# Build output: the evidence a pipeline step leaves behind, the bundle assembled from it, and
# the receipt from filing it. All of it belongs to a build, not to the repository.
evidence/
bundles/
filed/
*.cdx.json
receipt.json
retention.json
